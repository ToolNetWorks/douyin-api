[Unit]
Description=Douyin Channel Video Scraper REST API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/douyin
ExecStart=/root/douyin/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8088 --workers 1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
